default_platform(:ios)
require "shellwords"

APP_NAME = "FestiCore"
BUNDLE_ID = "io.festiCore.co"
LIVE_ACTIVITY_BUNDLE_ID = "#{BUNDLE_ID}.LiveActivity"
LIVE_ACTIVITY_TARGET = "FestiCoreLiveActivityExtension"
NOTIFICATION_SERVICE_BUNDLE_ID = "#{BUNDLE_ID}.NotificationService"
NOTIFICATION_SERVICE_TARGET = "FestiCoreNotificationServiceExtension"
STAGE_SCHEME = "FestiCore-Stage"
PROD_SCHEME = "FestiCore-Prod"
TEAM_ID = "N94CS4N6VR"
MATCH_KEYCHAIN_NAME = ENV.fetch("MATCH_KEYCHAIN_NAME", "match_keychain")
PROJECT_ROOT = File.expand_path("..", __dir__)

def require_environment!(*names)
  missing = names.select { |name| ENV[name].to_s.empty? }
  UI.user_error!("필수 환경 변수 누락: #{missing.join(', ')}") unless missing.empty?
end

def release_credentials!
  require_environment!(
    "MATCH_GIT_URL",
    "MATCH_PASSWORD",
    "APP_STORE_CONNECT_API_KEY_ID",
    "APP_STORE_CONNECT_ISSUER_ID",
    "APP_STORE_CONNECT_API_KEY_CONTENT"
  )
end

def connect_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT"),
    is_key_content_base64: true,
    in_house: false
  )
end

def prepare_signing_keychain
  require_environment!("MATCH_KEYCHAIN_PASSWORD")
  keychain_path = File.expand_path("~/Library/Keychains/#{MATCH_KEYCHAIN_NAME}-db")
  if File.exist?(keychain_path)
    unlock_keychain(
      path: keychain_path,
      password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD"),
      add_to_search_list: true,
      set_default: true
    )
  else
    create_keychain(
      name: MATCH_KEYCHAIN_NAME,
      password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD"),
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      add_to_search_list: true
    )
  end
end

def prepare_workspace(cache_profile: nil)
  sh("mise exec -- tuist install")
  cache_option = cache_profile ? " --cache-profile #{cache_profile}" : ""
  sh("mise exec -- tuist generate --no-open#{cache_option}")
end

def run_stage_tests
  prepare_workspace
  run_tests(
    workspace: File.expand_path("FestiCore.xcworkspace"),
    scheme: STAGE_SCHEME,
    devices: ["iPhone 17 Pro"],
    xcodebuild_formatter: "",
    xcargs: "CODE_SIGNING_ALLOWED=NO"
  )
end

def next_build_number(api_key, version)
  previous = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: BUNDLE_ID,
    version: version,
    initial_build_number: 0
  ).to_i
  [previous + 1, Time.now.strftime("%y%m%d%H%M").to_i].max.to_s
end

def signed_ipa(scheme, configuration, version, build_number, api_key)
  sentry_dsn = ENV["FESTICORE_SENTRY_DSN"]
  sentry_arg = sentry_dsn.to_s.empty? ? "" : " FESTICORE_SENTRY_DSN=#{Shellwords.escape(sentry_dsn)}"
  # 배포 archive는 서명되지 않은 Tuist 바이너리 캐시를 쓰지 않고 소스에서 빌드한다.
  prepare_workspace(cache_profile: "none")
  prepare_signing_keychain
  match(
    type: "appstore",
    readonly: true,
    api_key: api_key,
    git_url: ENV.fetch("MATCH_GIT_URL"),
    app_identifier: [BUNDLE_ID, LIVE_ACTIVITY_BUNDLE_ID, NOTIFICATION_SERVICE_BUNDLE_ID],
    keychain_name: MATCH_KEYCHAIN_NAME,
    keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD")
  )
  prepare_workspace
  update_code_signing_settings(
    path: File.join(PROJECT_ROOT, "Projects/App/FestiCore.xcodeproj"),
    targets: [APP_NAME],
    build_configurations: [configuration],
    use_automatic_signing: false,
    team_id: TEAM_ID,
    code_sign_identity: "Apple Distribution",
    profile_name: "match AppStore #{BUNDLE_ID}"
  )
  update_code_signing_settings(
    path: File.join(PROJECT_ROOT, "Projects/Widget/FestiCoreWidget/FestiCoreWidget.xcodeproj"),
    targets: [LIVE_ACTIVITY_TARGET],
    build_configurations: [configuration],
    use_automatic_signing: false,
    team_id: TEAM_ID,
    code_sign_identity: "Apple Distribution",
    profile_name: "match AppStore #{LIVE_ACTIVITY_BUNDLE_ID}"
  )
  update_code_signing_settings(
    path: File.join(PROJECT_ROOT, "Projects/Extension/FestiCoreNotificationService/FestiCoreNotificationService.xcodeproj"),
    targets: [NOTIFICATION_SERVICE_TARGET],
    build_configurations: [configuration],
    use_automatic_signing: false,
    team_id: TEAM_ID,
    code_sign_identity: "Apple Distribution",
    profile_name: "match AppStore #{NOTIFICATION_SERVICE_BUNDLE_ID}"
  )
  # Xcode 26 + pointfree 매크로의 clean-archive 레이스는 같은 DerivedData로 재시도하면 통과한다.
  build_attempts = 0
  begin
    build_attempts += 1
    build_app(
      workspace: File.expand_path("FestiCore.xcworkspace"),
      scheme: scheme,
      configuration: configuration,
      export_method: "app-store",
      output_directory: "fastlane/output",
      output_name: "#{APP_NAME}.ipa",
      clean: false,
      xcodebuild_formatter: "",
      xcargs: "FESTICORE_VERSION=#{version} FESTICORE_BUILD_NUMBER=#{build_number} FESTICORE_APNS_ENVIRONMENT=production#{sentry_arg}",
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          BUNDLE_ID => "match AppStore #{BUNDLE_ID}",
          LIVE_ACTIVITY_BUNDLE_ID => "match AppStore #{LIVE_ACTIVITY_BUNDLE_ID}",
          NOTIFICATION_SERVICE_BUNDLE_ID => "match AppStore #{NOTIFICATION_SERVICE_BUNDLE_ID}"
        }
      }
    )
  rescue => e
    raise e if build_attempts >= 3
    UI.important("archive 실패 (#{build_attempts}/3) — 같은 DerivedData로 재시도")
    retry
  end
end

platform :ios do
  before_all do
    Dir.chdir(File.expand_path("..", __dir__))
  end

  desc "Live Activity 및 알림 확장의 Development 및 AppStore 프로파일 발급"
  lane :provision_live_activity_signing do |options|
    require_environment!(
      "MATCH_PASSWORD",
      "APP_STORE_CONNECT_API_KEY_ID",
      "APP_STORE_CONNECT_ISSUER_ID",
      "APP_STORE_CONNECT_API_KEY_CONTENT"
    )
    api_key = connect_api_key
    prepare_signing_keychain
    ["development", "appstore"].each do |profile_type|
      match(
        type: profile_type,
        readonly: false,
        api_key: api_key,
        git_url: ENV.fetch("MATCH_GIT_URL", "git@github.com:Roy-wonji/FastlaneMatch.git"),
        app_identifier: [BUNDLE_ID, LIVE_ACTIVITY_BUNDLE_ID, NOTIFICATION_SERVICE_BUNDLE_ID],
        force: options[:force] == true,
        keychain_name: MATCH_KEYCHAIN_NAME,
        keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD")
      )
    end
    signed_ipa(
      PROD_SCHEME,
      "Prod",
      ENV.fetch("FESTICORE_VERSION", "1.0.0"),
      ENV.fetch("GITHUB_RUN_NUMBER", "1"),
      api_key
    )
  end

  desc "Stage 시뮬레이터 테스트"
  lane :test do
    run_stage_tests
  end

  desc "Stage 시뮬레이터 빌드"
  lane :build do
    prepare_workspace
    build_app(
      workspace: File.expand_path("FestiCore.xcworkspace"),
      scheme: STAGE_SCHEME,
      configuration: "Stage",
      sdk: "iphonesimulator",
      xcodebuild_formatter: "",
      skip_package_ipa: true,
      skip_codesigning: true
    )
  end

  desc "Attendance QA와 같은 Stage TestFlight 업로드"
  lane :QA do |options|
    release_credentials!
    version = options[:version] || ENV["FESTICORE_VERSION"]
    UI.user_error!("version 옵션 또는 FESTICORE_VERSION이 필요합니다.") if version.to_s.empty?
    api_key = connect_api_key
    build_number = next_build_number(api_key, version)
    ipa = signed_ipa(STAGE_SCHEME, "Stage", version, build_number, api_key)
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      changelog: options[:changelog] || "FestiCore QA 빌드 #{build_number}",
      skip_waiting_for_build_processing: true
    )
  end

  desc "Prod 빌드를 TestFlight에 업로드하고 App Store 버전을 준비"
  lane :release do |options|
    release_credentials!
    require_environment!("APP_STORE_CONNECT_TEAM_ID")
    version = options[:version] || ENV["FESTICORE_VERSION"]
    UI.user_error!("version 옵션 또는 FESTICORE_VERSION이 필요합니다.") if version.to_s.empty?
    api_key = connect_api_key
    build_number = next_build_number(api_key, version)
    ipa = signed_ipa(PROD_SCHEME, "Prod", version, build_number, api_key)
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      changelog: options[:changelog] || "FestiCore #{version}",
      skip_submission: true,
      skip_waiting_for_build_processing: false
    )
    upload_to_app_store(
      api_key: api_key,
      app_version: version,
      build_number: build_number,
      team_id: ENV.fetch("APP_STORE_CONNECT_TEAM_ID"),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false
    )
  end

  desc "지정한 App Store 버전과 빌드를 심사 제출"
  lane :submit_for_review do |options|
    release_credentials!
    require_environment!("APP_STORE_CONNECT_TEAM_ID")
    version = options[:version]
    UI.user_error!("version 옵션이 필요합니다.") if version.to_s.empty?
    build_number = options[:build_number]
    UI.user_error!("build_number 옵션이 필요합니다.") if build_number.to_s.empty?
    upload_to_app_store(
      api_key: connect_api_key,
      app_version: version,
      build_number: build_number,
      team_id: ENV.fetch("APP_STORE_CONNECT_TEAM_ID"),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false
    )
  end

  desc "Attendance tdd_ci에 대응하는 PR 시뮬레이터 검증"
  lane :tdd_ci do
    run_stage_tests
  end
end
