default_platform(:ios)
require "shellwords"

APP_NAME = "FestiCore"
BUNDLE_ID = "io.festiCore.co"
LIVE_ACTIVITY_BUNDLE_ID = "#{BUNDLE_ID}.LiveActivity"
LIVE_ACTIVITY_TARGET = "FestiCoreLiveActivityExtension"
NOTIFICATION_SERVICE_BUNDLE_ID = "#{BUNDLE_ID}.NotificationService"
NOTIFICATION_SERVICE_TARGET = "FestiCoreNotificationServiceExtension"
STAGE_SCHEME = "FestiCore-Stage"
PROD_SCHEME = "FestiCore-Prod"
TESTFLIGHT_GROUP = "FestiCore"
TEAM_ID = "N94CS4N6VR"
MATCH_KEYCHAIN_NAME = ENV.fetch("MATCH_KEYCHAIN_NAME", "match_keychain")
PROJECT_ROOT = File.expand_path("..", __dir__)

def require_environment!(*names)
  missing = names.select { |name| ENV[name].to_s.empty? }
  UI.user_error!("필수 환경 변수 누락: #{missing.join(', ')}") unless missing.empty?
end

def release_credentials!
  require_environment!(
    "MATCH_GIT_URL",
    "MATCH_PASSWORD",
    "APP_STORE_CONNECT_API_KEY_ID",
    "APP_STORE_CONNECT_ISSUER_ID",
    "APP_STORE_CONNECT_API_KEY_CONTENT"
  )
end

def connect_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_CONTENT"),
    is_key_content_base64: true,
    in_house: false
  )
end

def prepare_signing_keychain
  require_environment!("MATCH_KEYCHAIN_PASSWORD")
  keychain_path = File.expand_path("~/Library/Keychains/#{MATCH_KEYCHAIN_NAME}-db")
  if File.exist?(keychain_path)
    unlock_keychain(
      path: keychain_path,
      password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD"),
      add_to_search_list: true,
      set_default: true
    )
  else
    create_keychain(
      name: MATCH_KEYCHAIN_NAME,
      password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD"),
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      add_to_search_list: true
    )
  end
end

def prepare_workspace(cache_profile: nil)
  sh("mise exec -- tuist install")
  cache_option = cache_profile ? " --cache-profile #{cache_profile}" : ""
  sh("mise exec -- tuist generate --no-open#{cache_option}")
end

def run_stage_tests
  prepare_workspace
  run_tests(
    workspace: File.expand_path("FestiCore.xcworkspace"),
    scheme: STAGE_SCHEME,
    devices: ["iPhone 17 Pro"],
    xcodebuild_formatter: "",
    xcargs: "CODE_SIGNING_ALLOWED=NO"
  )
end

def next_build_number(api_key, version)
  previous = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: BUNDLE_ID,
    version: version,
    initial_build_number: 0
  ).to_i
  [previous + 1, Time.now.strftime("%y%m%d%H%M").to_i].max.to_s
end

# 처리 완료(VALID)만으로는 부족하다. 내부 테스트 상태가 준비돼야 그룹에 배포할 수 있다.
def wait_for_internal_testing(app, version, build_number, timeout:)
  ready_states = [
    Spaceship::ConnectAPI::BuildBetaDetail::InternalState::READY_FOR_BETA_TESTING,
    Spaceship::ConnectAPI::BuildBetaDetail::InternalState::IN_BETA_TESTING
  ]
  failed_states = [
    Spaceship::ConnectAPI::BuildBetaDetail::InternalState::PROCESSING_EXCEPTION,
    Spaceship::ConnectAPI::BuildBetaDetail::InternalState::MISSING_EXPORT_COMPLIANCE,
    Spaceship::ConnectAPI::BuildBetaDetail::InternalState::EXPIRED
  ]
  deadline = Time.now + timeout
  loop do
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: version, build_number: build_number).first
    processing = build&.processing_state
    if [Spaceship::ConnectAPI::Build::ProcessingState::FAILED, Spaceship::ConnectAPI::Build::ProcessingState::INVALID].include?(processing)
      UI.user_error!("TestFlight 빌드 처리 실패: #{build_number} (#{processing})")
    end
    internal = build&.build_beta_detail&.internal_build_state
    return build if processing == Spaceship::ConnectAPI::Build::ProcessingState::VALID && ready_states.include?(internal)
    UI.user_error!("TestFlight 내부 테스트 불가: #{build_number} (#{internal})") if failed_states.include?(internal)
    state = "#{processing || '미등록'}/#{internal || '-'}"
    UI.user_error!("TestFlight 빌드 대기 시간 초과: #{build_number} (#{state})") if Time.now > deadline
    UI.message("TestFlight 빌드 대기 중: #{build_number} (#{state})")
    sleep(30)
  end
end

# 테스터에게 보이는 "테스트할 사항"을 한국어로 넣는다.
def update_test_notes(build, notes)
  # pilot과 같은 규칙(이모지·'<' 제거, 4000바이트)으로 정리해야 Apple이 거부하지 않는다.
  # 이 레인은 upload_to_testflight를 부르지 않아 pilot이 로드되지 않으므로 직접 불러온다.
  require "pilot"
  notes = Pilot::BuildManager.sanitize_changelog(notes.dup)
  localization = build.get_beta_build_localizations.find { |candidate| candidate.locale == "ko" }
  if localization
    Spaceship::ConnectAPI.patch_beta_build_localizations(localization_id: localization.id, attributes: { whatsNew: notes })
  else
    Spaceship::ConnectAPI.post_beta_build_localizations(build_id: build.id, attributes: { locale: "ko", whatsNew: notes })
  end
end

def signed_ipa(scheme, configuration, version, build_number, api_key)
  sentry_dsn = ENV["FESTICORE_SENTRY_DSN"]
  sentry_arg = sentry_dsn.to_s.empty? ? "" : " FESTICORE_SENTRY_DSN=#{Shellwords.escape(sentry_dsn)}"
  # 배포 archive는 서명되지 않은 Tuist 바이너리 캐시를 쓰지 않고 소스에서 빌드한다.
  prepare_workspace(cache_profile: "none")
  prepare_signing_keychain
  match(
    type: "appstore",
    readonly: true,
    api_key: api_key,
    git_url: ENV.fetch("MATCH_GIT_URL"),
    app_identifier: [BUNDLE_ID, LIVE_ACTIVITY_BUNDLE_ID, NOTIFICATION_SERVICE_BUNDLE_ID],
    keychain_name: MATCH_KEYCHAIN_NAME,
    keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD")
  )
  prepare_workspace
  update_code_signing_settings(
    path: File.join(PROJECT_ROOT, "Projects/App/FestiCore.xcodeproj"),
    targets: [APP_NAME],
    build_configurations: [configuration],
    use_automatic_signing: false,
    team_id: TEAM_ID,
    code_sign_identity: "Apple Distribution",
    profile_name: "match AppStore #{BUNDLE_ID}"
  )
  update_code_signing_settings(
    path: File.join(PROJECT_ROOT, "Projects/Widget/FestiCoreWidget/FestiCoreWidget.xcodeproj"),
    targets: [LIVE_ACTIVITY_TARGET],
    build_configurations: [configuration],
    use_automatic_signing: false,
    team_id: TEAM_ID,
    code_sign_identity: "Apple Distribution",
    profile_name: "match AppStore #{LIVE_ACTIVITY_BUNDLE_ID}"
  )
  update_code_signing_settings(
    path: File.join(PROJECT_ROOT, "Projects/Extension/FestiCoreNotificationService/FestiCoreNotificationService.xcodeproj"),
    targets: [NOTIFICATION_SERVICE_TARGET],
    build_configurations: [configuration],
    use_automatic_signing: false,
    team_id: TEAM_ID,
    code_sign_identity: "Apple Distribution",
    profile_name: "match AppStore #{NOTIFICATION_SERVICE_BUNDLE_ID}"
  )
  # Xcode 26 + pointfree 매크로의 clean-archive 레이스는 같은 DerivedData로 재시도하면 통과한다.
  build_attempts = 0
  begin
    build_attempts += 1
    build_app(
      workspace: File.expand_path("FestiCore.xcworkspace"),
      scheme: scheme,
      configuration: configuration,
      export_method: "app-store",
      output_directory: "fastlane/output",
      output_name: "#{APP_NAME}.ipa",
      clean: false,
      # CI에서는 실행별 DerivedData를 써야 Clean deploy DerivedData 단계가 정리한다. 로컬은 기본 경로.
      derived_data_path: ENV["CI_DERIVED_DATA"],
      xcodebuild_formatter: "",
      xcargs: "FESTICORE_VERSION=#{version} FESTICORE_BUILD_NUMBER=#{build_number} FESTICORE_APNS_ENVIRONMENT=production#{sentry_arg}",
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          BUNDLE_ID => "match AppStore #{BUNDLE_ID}",
          LIVE_ACTIVITY_BUNDLE_ID => "match AppStore #{LIVE_ACTIVITY_BUNDLE_ID}",
          NOTIFICATION_SERVICE_BUNDLE_ID => "match AppStore #{NOTIFICATION_SERVICE_BUNDLE_ID}"
        }
      }
    )
  rescue => e
    raise e if build_attempts >= 3
    UI.important("archive 실패 (#{build_attempts}/3) — 같은 DerivedData로 재시도")
    retry
  end
end

platform :ios do
  before_all do
    Dir.chdir(File.expand_path("..", __dir__))
  end

  desc "Live Activity 및 알림 확장의 Development 및 AppStore 프로파일 발급"
  lane :provision_live_activity_signing do |options|
    require_environment!(
      "MATCH_PASSWORD",
      "APP_STORE_CONNECT_API_KEY_ID",
      "APP_STORE_CONNECT_ISSUER_ID",
      "APP_STORE_CONNECT_API_KEY_CONTENT"
    )
    api_key = connect_api_key
    prepare_signing_keychain
    ["development", "appstore"].each do |profile_type|
      match(
        type: profile_type,
        readonly: false,
        api_key: api_key,
        git_url: ENV.fetch("MATCH_GIT_URL", "git@github.com:Roy-wonji/FastlaneMatch.git"),
        app_identifier: [BUNDLE_ID, LIVE_ACTIVITY_BUNDLE_ID, NOTIFICATION_SERVICE_BUNDLE_ID],
        force: options[:force] == true,
        keychain_name: MATCH_KEYCHAIN_NAME,
        keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD")
      )
    end
    signed_ipa(
      PROD_SCHEME,
      "Prod",
      ENV.fetch("FESTICORE_VERSION", "1.0.0"),
      ENV.fetch("GITHUB_RUN_NUMBER", "1"),
      api_key
    )
  end

  desc "Stage 시뮬레이터 테스트"
  lane :test do
    run_stage_tests
  end

  desc "Stage 시뮬레이터 빌드"
  lane :build do
    prepare_workspace
    build_app(
      workspace: File.expand_path("FestiCore.xcworkspace"),
      scheme: STAGE_SCHEME,
      configuration: "Stage",
      sdk: "iphonesimulator",
      xcodebuild_formatter: "",
      skip_package_ipa: true,
      skip_codesigning: true
    )
  end

  desc "Attendance QA와 같은 Stage TestFlight 업로드"
  lane :QA do |options|
    release_credentials!
    version = options[:version] || ENV["FESTICORE_VERSION"]
    UI.user_error!("version 옵션 또는 FESTICORE_VERSION이 필요합니다.") if version.to_s.empty?
    api_key = connect_api_key
    build_number = next_build_number(api_key, version)
    ipa = signed_ipa(STAGE_SCHEME, "Stage", version, build_number, api_key)
    # changelog를 넘기면 pilot이 제한 없이 빌드 등록을 기다리므로 업로드만 한다.
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
    # 처리 대기·테스트 안내·그룹 배포는 CI의 다음 단계(distribute_internal)가 별도 제한 시간으로 맡는다.
    File.open(ENV["GITHUB_OUTPUT"], "a") { |file| file.puts("build_number=#{build_number}") } if ENV["GITHUB_OUTPUT"]
  end

  desc "업로드한 빌드의 처리 완료를 기다린 뒤 FestiCore 내부 테스트 그룹에 배포"
  lane :distribute_internal do |options|
    version = options[:version].to_s
    build_number = options[:build_number].to_s
    UI.user_error!("version, build_number 옵션이 필요합니다.") if version.empty? || build_number.empty?
    connect_api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("App Store Connect 앱을 찾을 수 없습니다: #{BUNDLE_ID}") if app.nil?
    group = app.get_beta_groups(filter: { name: TESTFLIGHT_GROUP }).find { |candidate| candidate.name == TESTFLIGHT_GROUP }
    UI.user_error!("TestFlight 그룹이 없습니다: #{TESTFLIGHT_GROUP}") if group.nil?
    UI.user_error!("#{TESTFLIGHT_GROUP}은 내부 테스트 그룹이 아닙니다.") unless group.is_internal_group

    build = wait_for_internal_testing(app, version, build_number, timeout: 40 * 60)
    update_test_notes(build, options[:changelog] || "FestiCore QA 빌드 #{build_number}")
    if group.has_access_to_all_builds
      UI.success("#{TESTFLIGHT_GROUP} 그룹은 모든 빌드를 자동으로 받습니다: #{version} (#{build_number})")
      next
    end
    build.add_beta_groups(beta_groups: [group])
    assigned = Spaceship::ConnectAPI.get_builds(
      filter: { app: app.id, version: build_number, betaGroups: group.id }
    ).to_models.any? { |candidate| candidate.id == build.id }
    UI.user_error!("#{TESTFLIGHT_GROUP} 그룹에 빌드가 연결되지 않았습니다: #{build_number}") unless assigned
    UI.success("#{TESTFLIGHT_GROUP} 내부 테스트 그룹에 배포 완료: #{version} (#{build_number})")
  end

  desc "Prod 빌드를 TestFlight에 업로드하고 App Store 버전을 준비"
  lane :release do |options|
    release_credentials!
    require_environment!("APP_STORE_CONNECT_TEAM_ID")
    version = options[:version] || ENV["FESTICORE_VERSION"]
    UI.user_error!("version 옵션 또는 FESTICORE_VERSION이 필요합니다.") if version.to_s.empty?
    api_key = connect_api_key
    build_number = next_build_number(api_key, version)
    ipa = signed_ipa(PROD_SCHEME, "Prod", version, build_number, api_key)
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      changelog: options[:changelog] || "FestiCore #{version}",
      skip_submission: true,
      skip_waiting_for_build_processing: false
    )
    upload_to_app_store(
      api_key: api_key,
      app_version: version,
      build_number: build_number,
      team_id: ENV.fetch("APP_STORE_CONNECT_TEAM_ID"),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false
    )
  end

  desc "지정한 App Store 버전과 빌드를 심사 제출"
  lane :submit_for_review do |options|
    release_credentials!
    require_environment!("APP_STORE_CONNECT_TEAM_ID")
    version = options[:version]
    UI.user_error!("version 옵션이 필요합니다.") if version.to_s.empty?
    build_number = options[:build_number]
    UI.user_error!("build_number 옵션이 필요합니다.") if build_number.to_s.empty?
    upload_to_app_store(
      api_key: connect_api_key,
      app_version: version,
      build_number: build_number,
      team_id: ENV.fetch("APP_STORE_CONNECT_TEAM_ID"),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false
    )
  end

  desc "Attendance tdd_ci에 대응하는 PR 시뮬레이터 검증"
  lane :tdd_ci do
    run_stage_tests
  end
end
