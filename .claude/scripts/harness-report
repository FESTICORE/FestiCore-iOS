#!/usr/bin/env python3
"""하네스 문서 · 규칙 · 에이전트 · 스킬 사용 리포트. (.claude/docs/harness.md 관측 · 정리)

사용: .claude/scripts/harness-report [--days 30]
- 문서 · 규칙 · 에이전트 · 스킬별 읽은 횟수와 마지막 사용일
- 기간 안에 한 번도 읽히지 않은 문서 · 규칙 · 에이전트 → 지우거나 합칠 후보
- verify 단계별 실패 횟수와 최근 실패 이유 → 매뉴얼 · 검사로 보강할 후보
"""
import argparse
import datetime
import glob
import json
import os
import subprocess


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--days", type=int, default=30)
    args = parser.parse_args()

    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True,
                          stdin=subprocess.DEVNULL).stdout.strip() or "."
    os.chdir(root)
    since = datetime.datetime.now() - datetime.timedelta(days=args.days)
    report_usage(since, args.days)
    report_verify(since, args.days)


def read_rows(path, since):
    with open(path, encoding="utf-8") as f:
        for line in f:
            try:
                row = json.loads(line)
                at = datetime.datetime.fromisoformat(row["at"])
            except (ValueError, KeyError):
                continue
            if at >= since:
                yield at, row


def report_usage(since, days):
    counts, last = {}, {}
    try:
        for at, row in read_rows(".claude/state/usage.jsonl", since):
            target = row.get("target", "")
            if target.startswith(".claude/skills/"):  # 스킬 안 파일은 스킬 단위로 묶는다
                target = "skill:" + target.split("/")[2]
            counts[target] = counts.get(target, 0) + 1
            last[target] = max(last.get(target, at), at)
    except OSError:
        # 기록이 없을 때 모든 문서를 정리 후보로 보이지 않게 여기서 멈춘다
        print("사용 기록이 없습니다 (.claude/state/usage.jsonl). Claude 세션에서 문서를 읽으면 쌓입니다.")
        return

    print(f"최근 {days}일 사용 (많은 순)")
    for target, count in sorted(counts.items(), key=lambda kv: -kv[1]):
        print(f"  {count:4d}  {last[target]:%Y-%m-%d}  {target}")

    known = sorted(glob.glob(".claude/docs/*.md") + glob.glob(".claude/docs/specs/*.md") + glob.glob(".claude/rules/*.md")
                   + glob.glob(".claude/agents/*.md")
                   + ["skill:" + os.path.basename(os.path.dirname(p)) for p in glob.glob(".claude/skills/*/SKILL.md")])
    unused = [k for k in known if k not in counts]
    print(f"\n최근 {days}일 한 번도 쓰이지 않음 (정리 후보 {len(unused)}개)")
    for target in unused:
        print(f"  {target}")


def report_verify(since, days):
    runs, fails, reasons = {}, {}, {}
    try:
        for at, row in read_rows(".claude/state/verify-history.jsonl", since):
            for step in row.get("steps", []):
                name = step.get("name", "?")
                runs[name] = runs.get(name, 0) + 1
                if not step.get("ok"):
                    fails[name] = fails.get(name, 0) + 1
                    if name not in reasons or at >= reasons[name][0]:  # 동시 실행으로 순서가 뒤섞여도 가장 최근 것
                        reasons[name] = (at, step.get("reason", ""), row.get("log_tail", [])[-1:])
    except OSError:
        print("\n검증 기록이 없습니다 (.claude/state/verify-history.jsonl). verify를 돌리면 쌓입니다.")
        return
    print(f"\n최근 {days}일 verify 단계별 실패 / 실행 (실패 많은 순)")
    for name in sorted(runs, key=lambda n: (-fails.get(n, 0), n)):
        line = f"  {fails.get(name, 0):4d} / {runs[name]:<4d} {name}"
        if name in reasons:
            at, reason, tail = reasons[name]
            line += f"  마지막 실패 {at:%Y-%m-%d}: {reason} {' '.join(tail)[:120]}"
        print(line)
    print("  같은 단계가 반복해 실패하면 원인을 겪은 문제에 적고, 세 번째부터 검사로 만든다.")


if __name__ == "__main__":
    main()
