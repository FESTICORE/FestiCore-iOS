#!/usr/bin/env python3
"""변경 경로에 맞는 검사 · 생성 · 테스트를 실행하고 결과를 증거로 남긴다. (docs/agent/harness.md 검증 게이트)

사용: .claude/scripts/verify          develop 이후 바뀐 코드에 맞는 단계만 실행
      .claude/scripts/verify --all    모든 단계 실행(./make test 전체)

- 통과하면 .claude/state/verify.json에 작업 트리 지문을 남긴다. 커밋 게이트와 종료 확인이 이 기록을 본다.
- 모든 명령은 stdin을 /dev/null로 닫고 실행한다. 출력은 .claude/state/verify/{단계}.log에 저장하고
  종료 코드를 파이프로 가리지 않는다.
- 같은 단계가 2번 연속 실패하면 세 번째 시도 전에 사용자에게 보고한다.
"""
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "hooks"))
import harness_state as hs  # noqa: E402

HARNESS_PATHS = (".claude/hooks/", ".claude/scripts/", ".claude/settings.json")
IOS_PREFIXES = ("Projects/", "Plugins/", "Tuist/", "Config/")
IOS_FILES = ("Tuist.swift", "Workspace.swift", "TuistTool.swift", "make", ".mise.toml")
TEST_PLAN = os.path.join("Projects", "App", "Tests", "FestiCore.xctestplan")
APP_TESTS = "FestiCoreTests"
FIREBASE_PLIST = os.path.join("Projects", "App", "Resources", "GoogleService-Info.plist")


def plan_targets():
    with open(TEST_PLAN, encoding="utf-8") as f:
        plan = json.load(f)
    return {item["target"]["name"] for item in plan.get("testTargets", [])}


def test_targets(ios_files):
    """바뀐 모듈의 테스트 타깃. None이면 전체 테스트(공용 빌드 설정 · 테스트 플랜 변경)."""
    known = plan_targets()
    targets = set()
    for path in ios_files:
        parts = path.split("/")
        if parts[0] != "Projects" or len(parts) < 3 or path.endswith(".xctestplan"):
            return None
        if parts[1] == "App":
            targets.add(APP_TESTS)
            continue
        name = parts[2] + "Tests"
        targets.add(name if name in known else APP_TESTS)  # 테스트 타깃이 없는 모듈은 앱 호스트 테스트로 본다
    return sorted(targets)


def steps_for(files, run_all, base):
    def touched(prefixes=(), names=()):
        return run_all or any(f.startswith(prefixes) or f in names for f in files)

    steps = []  # (이름, 명령)
    if touched(HARNESS_PATHS, (".claude/settings.json",)):
        steps.append(("harness-syntax", ["bash", "-c",
                                         'for f in .claude/hooks/*.sh; do bash -n "$f" || exit 1; done && '
                                         'python3 -c "import json; json.load(open(\'.claude/settings.json\'))"']))
        steps.append(("harness-tests", ["python3", "-m", "unittest", "discover", "-s", ".claude/hooks/tests"]))
    if touched(("Projects/",)):
        steps.append(("boundaries", [os.path.join(".claude", "scripts", "check-boundaries")]))
    if run_all or any(f.endswith(".swift") for f in files):
        steps.append(("swift-conventions", ["python3", ".claude/hooks/check-swift-conventions.py", "--base", base]))
    ios_files = [f for f in files if f.startswith(IOS_PREFIXES) or f in IOS_FILES]
    if run_all or ios_files:
        # 새 worktree는 외부 의존성이 없다. 실패한 generate가 빈 Tuist/.build만 만들 수 있어 checkouts로 본다.
        if not os.path.isdir(os.path.join("Tuist", ".build", "checkouts")):
            steps.append(("install", ["mise", "exec", "--", "tuist", "install"]))
        steps.append(("generate", ["./make", "generate", "--no-open"]))
        targets = None if run_all else test_targets(ios_files)
        only = [] if targets is None else [f"-only-testing:{t}" for t in targets]
        steps.append(("test", ["./make", "test", *only]))
    return steps


def main():
    root = hs.repo_root(os.getcwd())
    os.chdir(root)
    run_all = "--all" in sys.argv[1:]
    files = hs.changed_code_files(root)
    state = hs.load(root)
    failures = state.get("failures", {})

    steps = steps_for(files, run_all, hs.base_ref(root))
    if not steps:
        print("검증할 코드 변경이 없습니다(.md · DesignExports만 바뀌었거나 변경 없음).")
        hs.save(root, {"passed": True, "fingerprint": hs.fingerprint(root), "steps": [], "failures": {}})
        return 0

    if any(name == "test" for name, _ in steps) and not os.path.isfile(FIREBASE_PLIST):
        print(f"✘ 앱 호스트 테스트에 필요한 {FIREBASE_PLIST}가 없습니다(git 제외 파일).\n"
              "  원본 checkout의 같은 경로에서 복사한 뒤 다시 실행하세요. 예:\n"
              f"  cp \"$(git worktree list --porcelain | head -1 | cut -d' ' -f2-)/{FIREBASE_PLIST}\" {FIREBASE_PLIST}")
        return 1

    log_dir = os.path.join(hs.STATE_DIR, "verify")
    os.makedirs(log_dir, exist_ok=True)
    results = []
    total_started = time.monotonic()
    for name, cmd in steps:
        log_path = os.path.join(log_dir, f"{name}.log")
        print(f"▶ {name}: {' '.join(cmd)} < /dev/null (로그: {log_path})", flush=True)
        started = time.monotonic()
        with open(log_path, "w", encoding="utf-8") as log_file:
            code = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=log_file, stderr=subprocess.STDOUT).returncode
        seconds = round(time.monotonic() - started)
        if code != 0:
            with open(log_path, encoding="utf-8", errors="replace") as log_file:
                log = log_file.read()
            failures[name] = failures.get(name, 0) + 1
            print(f"✘ {name} 실패 ({seconds}초): 종료 코드 {code}")
            print("  마지막 로그:\n    " + "\n    ".join(log.strip().splitlines()[-15:]))
            if failures[name] >= hs.MAX_FAILURES:
                print(f"\n같은 단계({name})가 {failures[name]}번 연속 실패했습니다. "
                      "세 번째 시도 전에 시도한 내용과 실패 원인을 사용자에게 보고하고 승인을 받으세요.")
            hs.save(root, {"passed": False, "fingerprint": hs.fingerprint(root),
                           "steps": results + [{"name": name, "ok": False, "seconds": seconds, "code": code}],
                           "failures": failures})
            return 1
        failures.pop(name, None)
        results.append({"name": name, "ok": True, "seconds": seconds})
        print(f"✔ {name} ({seconds}초)")

    hs.save(root, {"passed": True, "fingerprint": hs.fingerprint(root), "steps": results, "failures": failures})
    print(f"검증 통과 ({round(time.monotonic() - total_started)}초). 기록: {hs.VERIFY_FILE}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
