#!/usr/bin/env python3
"""모듈 경계 검사. AGENTS.md가 정한 의존 방향을 import로 확인하고 어기면 실패한다. (docs/agent/harness.md)

사용: .claude/scripts/check-boundaries      (verify가 Projects/ 변경이 있을 때 실행한다)
규칙을 더하려면 RULES에 한 줄 추가하고 AGENTS.md · docs/agent/ 문서에 같은 규칙이 있는지 확인한다.
"""
import os
import re
import subprocess
import sys


def feature_modules(root):
    base = os.path.join(root, "Projects", "Feature")
    names = [n for n in os.listdir(base) if os.path.isdir(os.path.join(base, n)) and n != "FeatureAssembly"]
    return sorted(names)


def rules(root):
    features = "|".join(feature_modules(root))
    feature_code = ["Projects/Feature/*/Sources/**/*.swift", "Projects/Feature/*/Interface/**/*.swift"]
    # (이름, 검사할 파일 glob 목록, 허용 경로 glob 목록, 금지 패턴, 안내)
    return [
        ("Feature는 Domain 구현을 import하지 않는다", feature_code,
         ["Projects/Feature/FeatureAssembly/**"],
         r"^\s*(?:@testable\s+)?import\s+\w+Domain\b",
         "Domain Interface(<X>DomainInterface)의 UseCase를 @Dependency로 받는다. 조립은 FeatureAssembly가 한다"),
        ("Feature는 API · APIEndpoint · Network · Auth Service를 import하지 않는다", feature_code, [],
         r"^\s*(?:@testable\s+)?import\s+(?:API|APIEndpoint|FestiCoreNetwork\w*|FestiCoreAuth\w*)\b",
         "Feature는 Domain UseCase와 시스템 의존성만 주입받는다(docs/agent/domain-modules.md)"),
        ("APIEndpoint는 Domain · Auth Service에 의존하지 않는다", ["Projects/Service/APIEndpoint/Sources/**/*.swift"], [],
         r"^\s*(?:@testable\s+)?import\s+(?:\w+Domain\w*|FestiCoreAuth\w*)\b",
         "DTO ↔ Entity 변환은 Domain Mapper가 맡는다"),
        ("App은 개별 Feature 구현을 import하지 않는다", ["Projects/App/Sources/**/*.swift"], [],
         rf"^\s*(?:@testable\s+)?import\s+(?:{features})\b",
         "Feature는 FeatureAssembly에서 공개한다(<X>Interface는 허용)"),
        ("Sentry · Mixpanel은 FestiCoreAnalytics에서만 쓴다", ["Projects/**/*.swift"],
         ["Projects/Service/FestiCoreAnalytics/**"],
         r"^\s*(?:@testable\s+)?import\s+(?:Sentry\w*|Mixpanel)\b",
         "FestiCoreAnalyticsInterface의 UseCase를 주입받는다"),
    ]


def tracked_files(root):
    out = subprocess.run(["git", "-C", root, "ls-files", "--cached", "--others", "--exclude-standard"],
                         capture_output=True, text=True, check=True, stdin=subprocess.DEVNULL).stdout
    return out.splitlines()


def matches(path, pattern):
    # *는 폴더 한 단계 안에서만, **/는 0개 이상 폴더, 끝의 **는 그 아래 전부로 다룬다(fnmatch의 *는 /도 넘어 Tests까지 잡는다).
    regex = "".join(
        "(?:.*/)?" if part == "**/" else ".*" if part == "**" else "[^/]*" if part == "*" else re.escape(part)
        for part in re.split(r"(\*\*/|\*\*|\*)", pattern)
    )
    return re.fullmatch(regex, path) is not None


def main():
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True,
                          stdin=subprocess.DEVNULL).stdout.strip() or "."
    files = tracked_files(root)
    checks = rules(root)
    violations = []
    for name, targets, allowed, pattern, hint in checks:
        regex = re.compile(pattern, re.MULTILINE)
        for path in files:
            if not any(matches(path, t) for t in targets) or any(matches(path, a) for a in allowed):
                continue
            try:
                with open(os.path.join(root, path), encoding="utf-8", errors="replace") as f:
                    text = f.read()
            except OSError:
                continue
            for m in regex.finditer(text):
                line = text.count("\n", 0, m.start()) + 1
                violations.append(f"  {path}:{line}  [{name}] → {hint}")
    if violations:
        print("모듈 경계 위반 (AGENTS.md · docs/agent/domain-modules.md):")
        print("\n".join(violations))
        return 1
    print(f"모듈 경계 검사 통과 (규칙 {len(checks)}개)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
